# ============================================================
# WhatsApp PoP Verification — environment variables
# Copy to .env and fill in. Never commit real values.
# ============================================================

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- WhatsApp Cloud API (Meta) ---
# Token you invent; entered in the Meta App dashboard webhook config.
WHATSAPP_VERIFY_TOKEN=choose-a-random-string
# Meta App secret (App dashboard -> Settings -> Basic). Used to verify webhook signatures.
WHATSAPP_APP_SECRET=
# Permanent system-user access token with whatsapp_business_messaging permission.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0

# --- Anthropic (Claude Vision) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- Stitch (South African open banking) ---
STITCH_CLIENT_ID=
STITCH_CLIENT_SECRET=
STITCH_TOKEN_URL=https://secure.stitch.money/connect/token
STITCH_API_URL=https://api.stitch.money/graphql

# --- Supabase ---
SUPABASE_URL=
# Service role key: backend only, bypasses RLS (needed for cross-tenant duplicate check).
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=pop-images

# --- Internal automation (n8n) ---
# Shared secret n8n sends as X-Internal-Api-Key when calling /internal/* endpoints.
INTERNAL_API_KEY=choose-another-random-string

# --- Decision engine tuning (optional, defaults shown) ---
MATCH_TIME_WINDOW_HOURS=72
AMOUNT_TOLERANCE_CENTS=0
MIN_EXTRACTION_CONFIDENCE=0.5

# --- Payment reminders (Phase 2; optional, defaults shown) ---
REMINDER_CADENCE_DAYS=3
REMINDER_MAX_SENDS=3
